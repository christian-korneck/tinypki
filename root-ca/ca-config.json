{
  "signing": {
    "default": {
      "expiry": "${VALIDITY_INTERMEDIATE_CA}"
    },
    "profiles": {
      "intermediate": {
        "usages": [
          "signing",
          "digital signature",
          "key encipherment",
          "cert sign",
          "crl sign"
        ],
        "expiry": "${VALIDITY_INTERMEDIATE_CA}",
        "ca_constraint": {
          "is_ca": true,
          "max_path_len": 1,
          "max_path_len_zero": false
        }
      }
    }
  }
}
